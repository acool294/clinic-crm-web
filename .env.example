# Copy to .env.local and fill in. All of these stay on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Protects /api/jobs/run (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Messaging (optional; without them messages are marked "skipped")
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
RESEND_API_KEY=
EMAIL_FROM=
